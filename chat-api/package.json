{
  "name": "ka-nails-chat-api",
  "version": "0.1.0",
  "private": true,
  "description": "KA Nails AI receptionist on Cloudflare Workers, Workers AI and Supabase",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "evaluate": "node --import tsx tools/evaluate-workers-ai.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.161.0"
  },
  "dependencies": {
    "stripe": "23.1.0"
  }
}

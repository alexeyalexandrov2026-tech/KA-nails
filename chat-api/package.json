{
  "name": "ka-nails-chat-api",
  "version": "0.1.0",
  "private": true,
  "description": "KA Nails AI receptionist: Azure Functions + a model on OpenRouter or Claude in Microsoft Foundry",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "0.5.2",
    "@anthropic-ai/sdk": "0.131.0",
    "@azure/communication-email": "1.1.0",
    "@azure/data-tables": "13.3.2",
    "@azure/functions": "4.16.5",
    "@azure/identity": "4.13.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
